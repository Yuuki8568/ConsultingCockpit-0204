{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consulting-cockpit-migration",
  "main": "packages/web/src/worker.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "alias": { "@libsql/client": "@libsql/client/web" },
  "assets": {
    "directory": "packages/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": false },
  "env": {
    "staging": {
      "name": "consulting-cockpit-staging",
      "d1_databases": [{"binding": "COCKPIT_MIGRATION_DB", "database_name": "consulting-cockpit-db", "database_id": "be004feb-0f63-4d9d-b0eb-1c275949081c"}],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "vars": { "NODE_ENV": "production", "DEPLOYMENT_TARGET": "cloudflare" }
    },
    "production": {
      "name": "consulting-cockpit-production",
      "vars": { "NODE_ENV": "production", "DEPLOYMENT_TARGET": "cloudflare" }
    }
  }
}
